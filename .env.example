# .env — Nexomate Production Configuration
# Copy this file to .env and fill in your real credentials.

# ── SMTP (Email Sending) ─────────────────────────────────────────────
# Hostinger: smtp.hostinger.com / 465 (SSL)
# Gmail: smtp.gmail.com / 587 (use App Password, NOT regular password)
# Outlook: smtp-mail.outlook.com / 587
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=connect@getnexomate.com
SMTP_PASSWORD=your_email_password

# ── IMAP (Reply Tracking) ────────────────────────────────────────────
# Hostinger: imap.hostinger.com / 993
# Gmail: imap.gmail.com / 993
# Outlook: outlook.office365.com / 993
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=connect@getnexomate.com
IMAP_PASSWORD=your_email_password

# ── Ollama (AI) ──────────────────────────────────────────────────────
# Install Ollama: https://ollama.com
# Then run: ollama pull llama3.1 && ollama serve
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
