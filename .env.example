# Nexomate Environment Configuration
# Copy this file to .env and fill in your credentials.

# ── 1. AI Provider ───────────────────────────────────────────────────────
# AI_PROVIDER: "auto" (try Groq→Ollama), "groq" (cloud only), "ollama" (local only)
AI_PROVIDER=auto

# ── 2. Groq (Free Cloud AI — https://console.groq.com) ──────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ── 3. Ollama (Local AI — optional for local development) ────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── 4. SMTP (Outbound Email Sending Relay) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── 5. IMAP (Inbound Email Reply Intercept) ──────────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ── 6. Batch Email Throttling ────────────────────────────────────────────
# EMAIL_BATCH_SIZE=25
# EMAIL_BATCH_DELAY_SECONDS=3
