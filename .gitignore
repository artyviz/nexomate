# Nexomate — ignore rules

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Environment
.env
.venv/
venv/
env/

# Data (local database & exports)
data/nexomate.db
data/exports/*.xlsx
data/imports/*
!data/.gitkeep
!data/exports/.gitkeep
!data/imports/.gitkeep

# Logs
logs/*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Google OAuth secrets — NEVER commit these
client_secret*.json

# SQLite WAL/SHM files
*.db-wal
*.db-shm

# Scrapped / Node modules / Temporary artifacts
scrapped/
node_modules/
.freebuff/
.vs/
deploy_hostinger.sh
